{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of the main window, the one that owns the workspace: the commands of the app (the state among them, which no other window gets), the events it exchanges with the other windows and the Rust side, the home folder, and the title bar (its buttons, and the drag region whose double click maximizes the window). Nothing else of the core permission sets (no webview, menu, tray, image, resource or app permissions).",
  "windows": ["main"],
  "permissions": [
    "allow-ai-providers",
    "allow-ai-configure",
    "allow-ai-ollama-models",
    "allow-ai-ollama-memory",
    "allow-ai-test-connection",
    "allow-ai-set-key",
    "allow-ai-chat-stream",
    "allow-ai-cancel",
    "allow-profiles-list",
    "allow-profiles-set-user",
    "allow-session-create",
    "allow-session-attach",
    "allow-session-reattach",
    "allow-sessions-keep-set",
    "allow-quick-shortcut-set",
    "allow-quick-toggle",
    "allow-session-write",
    "allow-session-resize",
    "allow-session-kill",
    "allow-session-retry",
    "allow-state-load",
    "allow-state-save",
    "allow-state-quarantine",
    "allow-project-actions-read",
    "allow-project-command-run",
    "allow-git-info",
    "allow-agents-scan",
    "allow-worktree-list",
    "allow-worktree-create",
    "allow-worktree-remove",
    "allow-ssh-hosts-list",
    "allow-docker-containers-list",
    "allow-config-load",
    "allow-config-save",
    "allow-config-watch",
    "allow-theme-list",
    "allow-theme-save",
    "allow-bench-list",
    "allow-bench-save",
    "allow-scrollback-load",
    "allow-scrollback-list",
    "allow-scrollback-save",
    "allow-scrollback-delete",
    "allow-app-close-listening",
    "allow-app-close-ready",
    "allow-mod-list",
    "allow-mod-watch",
    "allow-plugins-list",
    "allow-gallery-index",
    "allow-gallery-installed",
    "allow-gallery-install",
    "allow-sync-status",
    "allow-sync-connect",
    "allow-sync-pull",
    "allow-sync-push",
    "allow-sync-spaces-list",
    "allow-sync-spaces-read",
    "allow-sync-spaces-write",
    "allow-sync-spaces-link",
    "allow-sync-gist-status",
    "allow-sync-gist-set-token",
    "allow-sync-gist-clear-token",
    "allow-sync-gist-connect",
    "allow-sync-gist-pull",
    "allow-sync-gist-push",
    "allow-update-status",
    "allow-update-check",
    "allow-update-install",
    "allow-window-effect-set",
    "allow-background-image-read",
    "allow-file-preview-read",
    "allow-git-diff-read",
    "allow-fonts-list-monospace",
    "allow-hardware-read",
    "allow-link-open",
    "allow-browser-open",
    "allow-browser-navigate",
    "allow-browser-set-bounds",
    "allow-browser-close",
    "allow-window-open",
    "allow-window-close",
    "allow-window-move-tab",
    "allow-notify-show",
    "allow-window-is-focused",
    "allow-deep-link-take-waiting",
    "allow-deep-link-applied",
    "allow-api-respond",
    "allow-api-ready",
    "allow-api-agent-state",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:path:allow-resolve-directory",
    "core:window:allow-is-maximized",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
