{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noren",
  "version": "0.0.1-dev",
  "identifier": "io.github.marllon.noren",
  "mainBinaryName": "noren",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm --filter @noren/desktop run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noren",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["noren"]
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/shell-integration/*", "resources/shell-integration/zsh/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
