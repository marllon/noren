{
  "id": "cmd-bash-10",
  "kind": "command",
  "shell": "bash",
  "prompt": "Write a bash command that makes the file deploy.sh executable.",
  "check": {
    "accept": [
      "chmod +x deploy.sh",
      "chmod u+x deploy.sh",
      "chmod a+x deploy.sh",
      "chmod 755 deploy.sh",
      "chmod 744 deploy.sh"
    ]
  },
  "examples": {
    "pass": [
      "chmod +x deploy.sh",
      "chmod u+x deploy.sh",
      "chmod 755 deploy.sh",
      "$ chmod +x deploy.sh"
    ],
    "fail": ["chmod -x deploy.sh", "chmod 644 deploy.sh", "chmod +x build.sh", "./deploy.sh"]
  }
}
