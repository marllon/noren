{
  "id": "cmd-pwsh-02",
  "kind": "command",
  "shell": "pwsh",
  "prompt": "Write a PowerShell command that finds every file with the .log extension in the current folder and all its subfolders.",
  "check": {
    "accept": [
      "Get-ChildItem -Recurse -Filter *.log",
      "Get-ChildItem -Recurse -Include *.log",
      "Get-ChildItem -Path . -Recurse -Filter *.log",
      "Get-ChildItem . -Recurse -Filter *.log"
    ],
    "aliases": [["Get-ChildItem", "gci", "ls", "dir"]],
    "flagOrder": "any",
    "flagsWithValue": ["-Filter", "-Include", "-Path"]
  },
  "examples": {
    "pass": [
      "Get-ChildItem -Recurse -Filter *.log",
      "gci -Filter *.log -Recurse",
      "dir -Recurse -Include '*.log'",
      "Get-ChildItem -Path . -Filter \"*.log\" -Recurse"
    ],
    "fail": [
      "Get-ChildItem -Filter *.log",
      "Get-ChildItem -Recurse -Filter *.txt",
      "Get-ChildItem -Recurse"
    ]
  }
}
